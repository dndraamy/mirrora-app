        <!-- Association User -> DailyRoutine -->
        <mxCell id="rel_ur" value="+1..*" style="endArrow=none;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_user" target="c_routine">
