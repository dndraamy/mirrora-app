<mxfile host="app.diagrams.net">
  <diagram id="mirrora_class_diagram" name="Class Diagram Mirrora">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- User Class -->
        <mxCell id="c_user" value="User&#xa;--&#xa;+Id: string&#xa;+Name: string&#xa;+Email: string&#xa;+IsBiometric: bool&#xa;+CreatedAt: DateTime&#xa;--&#xa;+Login(): bool&#xa;+Register(): bool&#xa;+UpdateProfile(): void&#xa;+ToggleBiometric(): void&#xa;+ShakeDevice(): void" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
